# Copy to .env and fill in. Names only here, never a real value, per env.rules.md.
# .env is gitignored. There is no Secret Manager in this project by design; see the README.

# Profile: local or cloud. Selects where the database lives, nothing else.
BRAIN_PROFILE=local

# Paths. Both default to the sibling `docs` checkout and this repo's graph/ folder.
BRAIN_VAULT=
BRAIN_GRAPH_DIR=

# PostgreSQL 18 with pgvector. Holds the relational, vector and graph stores at once.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=brain
DB_USERNAME=brain
DB_PASSWORD=

# Embeddings. Voyage 3.5 at 1024 dimensions.
# 1024 is not a preference: pgvector will not build an HNSW index above 2000, so the 2048
# option would silently leave every search doing a sequential scan.
# Changing this model or this number means re-embedding the whole corpus.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage/voyage-3.5
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=

# Chat model, used by cognify to build the graph. Voyage has no chat model, so this is a
# separate vendor and a separate key. Swapping it is free; swapping the embedding model is not.
# Uncomment one.
LLM_PROVIDER=anthropic
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-5-mini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-2.5-flash
#
# Or borrow the MCP host's model and set no key at all. This works only inside an MCP session:
# `brain ingest` is a plain process with no host to sample from and still needs a key above.
# LLM_PROVIDER=mcp-sampling

# Connection pooling. max-instances x (pool + overflow) must fit the database max_connections.
POOL_ARGS={"pool_size": 2, "max_overflow": 3}
VECTOR_POOL_ARGS={"pool_size": 2, "max_overflow": 2}

# Chunking.
CHUNK_SIZE=1500
CHUNK_OVERLAP=10

# cloud profile only. PROJECT:REGION:INSTANCE.
CLOUDSQL_INSTANCE=
