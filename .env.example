# Copy to .env and fill in. Names and placeholders only; .env itself is never committed.

# Folder holding every project to remember, absolute; mounted read-only into the server
PMB_WORKSPACE=C:/Users/you/projects

# Obsidian vault for generated notes; defaults to the sibling docs checkout
# PMB_DOCS=C:/Users/you/docs

# PostgreSQL 18 with pgvector, as the host sees it; compose sets the server's own
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=plugmybrain
DB_USERNAME=plugmybrain
DB_PASSWORD=

# Host port for Postgres; compose.override.yaml sets 15432 on a laptop
# DB_PUBLISH_PORT=5432

# Host port for the MCP server
# MCP_PUBLISH_PORT=9000

# Postgres elsewhere, such as the VM through scripts/tunnel.ps1
# PMB_DB_HOST=host.docker.internal
# PMB_DB_PORT=25432

# Embedding, option 1: an API. Voyage shown; any LiteLLM embedding provider works
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage/voyage-3.5
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
# Atlas-issued Voyage key (starts al-) only; a dash.voyageai.com key leaves it unset
# EMBEDDING_ENDPOINT=https://ai.mongodb.com/v1

# Embedding, option 2: Ollama on this machine, no key. Run `ollama pull bge-m3` first
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_ENDPOINT=http://host.docker.internal:11434/api/embed

# Voyage free tier without a payment method: 3 requests and 10,000 tokens per minute
# EMBEDDING_RATE_LIMIT_ENABLED=true
# EMBEDDING_RATE_LIMIT_REQUESTS=3
# EMBEDDING_RATE_LIMIT_INTERVAL=60
# EMBEDDING_RATE_LIMIT_TOKENS=10000
# EMBEDDING_BATCH_SIZE=6
# EMBEDDING_MAX_CONCURRENT_DATA_POINTS=6

# Connection pools; pool plus overflow must fit max_connections=20
POOL_ARGS={"pool_size": 2, "max_overflow": 3}
VECTOR_POOL_ARGS={"pool_size": 2, "max_overflow": 2}

# Characters per chunk, and overlap
CHUNK_SIZE=1500
CHUNK_OVERLAP=10

# Vector index: auto, exact, ivfflat or hnsw; exact below the threshold
PMB_INDEX=auto
PMB_INDEX_THRESHOLD=10000

# Nightly pg_dump bucket and retention, VM only
BACKUP_BUCKET=
BACKUP_KEEP_DAYS=14

# The tunnel to the VM, laptop only
PMB_VM=
PMB_ZONE=
PMB_PROJECT=
