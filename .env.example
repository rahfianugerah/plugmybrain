# Copy to .env and fill in. Names only here, never a real value, per env.rules.md.
# .env is gitignored on the laptop and chmod 600, root-owned on the VM. There is no Secret
# Manager in this project by design; see the README.
#
# One Docker stack runs everywhere, so there is no profile switch. DB_HOST and DB_PORT are the
# only things that differ between hosts.

# Paths. A relative value is resolved against THIS REPOSITORY, not your shell's directory.
#
#   PMB_VAULT      ../docs  is OUTSIDE this project: a sibling folder and its own git repo.
#                  It holds rules/ and memory/, which are human-authored and win on conflict,
#                  and graph/, which this project generates and gitignores.
#   PMB_GRAPH_DIR  graph    is INSIDE this project and gitignored. Graphify output lands here
#                  and never inside the folder being mapped, so pointing the tool at another
#                  repository leaves no trace in it.
#
# Both values below are the defaults, written out rather than left blank. Deleting them gives
# exactly the same result.
PMB_VAULT=../docs
PMB_GRAPH_DIR=graph

# PostgreSQL 18 with pgvector. Holds the relational, vector and graph stores at once.
#   inside the compose network:  DB_HOST=postgres    DB_PORT=5432   (set by compose.yaml)
#   on the VM itself:            DB_HOST=127.0.0.1   DB_PORT=5432
#   on the laptop, over the SSH tunnel from scripts/tunnel.ps1:
#                                DB_HOST=127.0.0.1   DB_PORT=15432
# 15432 avoids colliding with a dev Postgres already holding 5432. On this machine one is
# already listening there, so the laptop stack publishes on 15432 via compose.override.yaml.
DB_HOST=127.0.0.1
DB_PORT=15432

# Which host port the container publishes Postgres on. The VM uses the default; the laptop
# override forces 15432. Only set this to move it somewhere else again.
# DB_PUBLISH_PORT=5432
DB_NAME=plugmybrain
DB_USERNAME=plugmybrain
DB_PASSWORD=

# Embeddings. Voyage 3.5 at 1024 dimensions.
# 1024 is not a preference: pgvector will not build an HNSW index above 2000, so the 2048
# option would silently leave every search doing a sequential scan.
# Changing this model or this number means re-embedding the whole corpus.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage/voyage-3.5
EMBEDDING_DIMENSIONS=1024
# MongoDB acquired Voyage, so the same model is reachable through two doors and the key you
# hold decides which one. They are not interchangeable, and using the wrong pair returns a 403
# that reads like an invalid key rather than a wrong address:
#
#   key from cloud.mongodb.com (Atlas, starts `al-`)  ->  EMBEDDING_ENDPOINT below is required
#   key from dash.voyageai.com (starts `pa-`)         ->  leave EMBEDDING_ENDPOINT unset
EMBEDDING_API_KEY=
# Only for an Atlas-issued key. litellm appends /embeddings itself, so omit it here.
EMBEDDING_ENDPOINT=https://ai.mongodb.com/v1

# Free tier, no payment method on file: 3 requests per minute and 10,000 tokens per minute.
# Cognee's defaults send 4 concurrent requests of 36 texts, which exceeds that immediately and
# surfaces as a 422 that says "verify EMBEDDING_ENDPOINT" rather than "you are rate limited".
# Uncomment these to stay inside the free tier. It works, and it is slow.
#
# Adding a payment method is the faster fix and is free at this scale: the 200M free tokens for
# the Voyage 3 series still apply, and this whole corpus is about 77,000 tokens.
# EMBEDDING_RATE_LIMIT_ENABLED=true
# EMBEDDING_RATE_LIMIT_REQUESTS=3
# EMBEDDING_RATE_LIMIT_INTERVAL=60
# EMBEDDING_RATE_LIMIT_TOKENS=10000
# EMBEDDING_BATCH_SIZE=6
# EMBEDDING_MAX_CONCURRENT_DATA_POINTS=6

# Chat model, used by cognify to build the graph. Voyage has no chat model, so this is a
# separate vendor and a separate key. Swapping it is free; swapping the embedding model is not.
# Uncomment one.
LLM_PROVIDER=anthropic
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=openai/gpt-5-mini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-3.5-flash
# Not gemini-2.5-flash: it still appears in the models list but generateContent answers
# 404 "no longer available to new users", so it fails only once ingestion is under way.
#
# Or borrow the MCP host's model and set no key at all. This works only inside an MCP session:
# `pmb ingest` is a plain process with no host to sample from and still needs a key above.
# LLM_PROVIDER=mcp-sampling

# Connection pooling. max-instances x (pool + overflow) must fit the database max_connections.
POOL_ARGS={"pool_size": 2, "max_overflow": 3}
VECTOR_POOL_ARGS={"pool_size": 2, "max_overflow": 2}

# Chunking.
CHUNK_SIZE=1500
CHUNK_OVERLAP=10

# Vector index: auto, exact, ivfflat or hnsw.
# auto uses exact search below PMB_INDEX_THRESHOLD rows and IVFFlat above it. Exact is not a
# concession at small sizes: pgvector sizes IVFFlat at lists = rows / 1000, so a few hundred
# chunks would get a one-list index, which is a sequential scan carrying index overhead.
# hnsw is faster to query but wants roughly 4 GiB; on a 2 GiB VM its build is what OOMs.
PMB_INDEX=auto
PMB_INDEX_THRESHOLD=10000

# Nightly pg_dump target, VM only. The bucket and its IAM binding are created by hand.
BACKUP_BUCKET=
BACKUP_KEEP_DAYS=14

# The tunnel, laptop only. Used by scripts/tunnel.ps1.
PMB_VM=
PMB_ZONE=
PMB_PROJECT=
